#include "Xresources.d/themes/oktwilight"

Xft.antialias: true
Xft.hinting: true
Xft.rgba: rgb
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault
Xterm*utf8: true
XTerm.vt100.font: 7x13
XTerm.vt100.faceName: xft:Terminus:pixelsize=16:style=Regular
XTerm.vt100.metaSendsEscape: true
XTerm.vt100.backarrowKey: false
XTerm.vt100.selectToClipboard: true
XTerm.vt100.translations: #override \
    Shift Ctrl <Key> C: copy-selection(CLIPBOARD) \n\
    Shift Ctrl <Key> V: insert-selection(CLIPBOARD) \n\
    Shift<Btn1Down>: select-start() \n\
    Shift<Btn1Motion>: select-extend() \n\
    Shift<Btn1Up>: select-end(CLIPBOARD)
XTerm.ttyModes: erase ^?
XTerm.termName: xterm-256color

XTerm*boldMode: true
! XClock*foreground: #a89984
! XClock*background: #1d2021
XClock*geometry: 128x128+0-32
XClock*strftime:  %a %d, %H:%M
XClock.Clock.analog: true
XClock.Clock.update: 1
XClock.Clock.face: monospace:style=Italic:size=13
XClock.Clock.background:  #282828
XClock.Clock.foreground:  #878787
XClock.Clock.majorColor:  #878787
XClock.Clock.minorColor:  #878787
XClock.Clock.hourColor:   #878787
XClock.Clock.minuteColor: #878787
XClock.Clock.secondColor: #878787
xosview*geometry: 128x128+128-32
xosview*font: 7x13
xosview*labels: false
xosview*background: #282828
xosview*foreground: #878787
xosview*load: false
xosview*cpu: true
xosview*cpuFormat: single
xosview*cpuFields: USED
xosview*cpuFreeColor: #282828
xosview*mem: true
xosview*memUsedColor: #8b9965
xosview*memSharedColor: #cf6a4c
xosview*memBufferColor: #7587a6
xosview*memCacheColor: #9d923c
xosview*memKernelColor: #9b859d
xosview*memSlabColor: #9b859d
xosview*memMapColor: #9b859d
xosview*memFreeColor: #282828
xosview*swap: false
xosview*page: false
xosview*gfx: false
xosview*NFSStats: false
xosview*NFSDStats: false
xosview*wireless: false
xosview*disk: false
xosview*battery: false
xosview*net: true
xosview*netInColor: #b2883a
xosview*netOutColor: #9d923c
xosview*netBackground: #282828

